# Dhan API (web.dhan.co -> My Profile -> Access DhanHQ APIs)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# AI agents: LLM_PROVIDER=gemini (uses GEMINI_API_KEY) or claude (uses ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# false = paper trading (journal only, no real orders). Set true only after paper testing.
LIVE_TRADING=false

CAPITAL_PER_TRADE=20000
MAX_POSITIONS=3
MAX_DAILY_LOSS=2000
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
EXIT_BY=09:45
MIN_TURNOVER_CR=50
GEMINI_MODEL=gemini-3.8-flash
CLAUDE_MODEL=claude-opus-5
UNIVERSE_FILE=universe.txt
DATA_DIR=data
