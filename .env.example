STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
EXIT_BY=09:45
MIN_TURNOVER_CR=50
CLAUDE_MODEL=claude-opus-5
UNIVERSE_FILE=universe.txt
DATA_DIR=data
