# Dhan API (web.dhan.co -> My Profile -> Access DhanHQ APIs)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# false = paper trading (journal only, no real orders). Set true only after paper testing.
LIVE_TRADING=false

CAPITAL_PER_TRADE=20000
# Up to this many BTST buys (each CAPITAL_PER_TRADE, so total exposure is the product) and sell ideas
MAX_POSITIONS=10
MAX_SELL_IDEAS=10
MAX_DAILY_LOSS=2000
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
EXIT_BY=09:45
MIN_TURNOVER_CR=50
UNIVERSE_FILE=universe.txt
DATA_DIR=data
